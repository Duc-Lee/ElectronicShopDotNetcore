@model List<ElectronicShopMVC.Model.Voucher>
@{
    ViewData["Title"] = "Quản lý Voucher - Admin";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom border-secondary border-opacity-10 pb-3">
        <h2 class="h3 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-gift text-primary"></i>
            <span class="gradient-text">Quản lý Mã Giảm Giá (Vouchers)</span>
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-2"></i>Thêm Voucher Mới
        </a>
    </div>

    <!-- Table Card -->
    <div class="glass-panel p-4">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-gift text-muted opacity-30 mb-3" style="font-size: 4rem;"></i>
                <h5 class="fw-bold text-muted">Chưa có mã giảm giá nào hoạt động</h5>
                <a asp-action="Create" class="btn btn-outline-primary btn-sm mt-3">Tạo ngay</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tblVouchers">
                    <thead>
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <th>Mã Code</th>
                            <th>Tiêu Đề</th>
                            <th>Loại Giảm</th>
                            <th class="text-end">Giá Trị</th>
                            <th class="text-end">Đơn Tối Thiểu</th>
                            <th class="text-center">Đã Dùng</th>
                            <th>Thời Hạn</th>
                            <th>Trạng Thái</th>
                            <th class="text-end" style="width: 15%;">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var voucher in Model)
                        {
                            var discountTypeText = voucher.DiscountType switch
                            {
                                "Percentage" => "Theo %",
                                "FixedAmount" => "Số tiền cố định",
                                "FreeShipping" => "Miễn phí ship",
                                _ => voucher.DiscountType
                            };

                            var statusClass = voucher.IsActive && DateTime.UtcNow >= voucher.StartDate && DateTime.UtcNow <= voucher.EndDate
                                ? "badge text-bg-success"
                                : "badge bg-secondary text-white";

                            var statusText = voucher.IsActive && DateTime.UtcNow >= voucher.StartDate && DateTime.UtcNow <= voucher.EndDate
                                ? "Đang chạy"
                                : !voucher.IsActive ? "Tắt" : "Hết hạn";

                            <tr>
                                <td>
                                    <span class="font-monospace fw-extrabold text-primary border border-primary border-opacity-25 rounded px-2 py-1 bg-primary bg-opacity-5">
                                        @voucher.Code
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-main">@voucher.Title</div>
                                    <div class="text-muted small text-truncate" style="max-width: 200px;">@voucher.Description</div>
                                </td>
                                <td class="text-muted small fw-semibold">
                                    @discountTypeText
                                </td>
                                <td class="text-end fw-bold text-main">
                                    @(voucher.DiscountType == "Percentage" ? $"{voucher.DiscountValue:G0}%" : $"{voucher.DiscountValue:N0}đ")
                                </td>
                                <td class="text-end text-muted small">
                                    @voucher.MinOrderAmount.ToString("N0")đ
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold text-main">@voucher.UsedCount</span>
                                    <span class="text-muted small">/@(voucher.MaxUses > 0 ? voucher.MaxUses.ToString() : "∞")</span>
                                </td>
                                <td class="small text-muted text-nowrap">
                                    <div><i class="bi bi-play-fill text-success small"></i> @voucher.StartDate.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                    <div><i class="bi bi-stop-fill text-danger small"></i> @voucher.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="@statusClass" style="font-size: 0.7rem;">
                                        @statusText
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@voucher.Id" class="btn btn-secondary btn-sm me-1 py-2">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                    <button onclick="DeleteVoucher('/Admin/Voucher/Delete/@voucher.Id')" class="btn btn-outline-danger btn-sm py-2">
                                        <i class="bi bi-trash-fill"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#tblVouchers').length) {
                $('#tblVouchers').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Vietnamese.json"
                    },
                    "pageLength": 10,
                    "lengthMenu": [5, 10, 20, 50],
                    "dom": '<"d-flex flex-wrap justify-content-between align-items-center mb-3"<"d-flex align-items-center"l><"d-flex align-items-center"f>>rt<"d-flex flex-wrap justify-content-between align-items-center mt-3"ip>'
                });
            }
        });

        function DeleteVoucher(url) {
            Swal.fire({
                title: 'Bạn có chắc chắn?',
                text: "Thao tác này sẽ xóa mềm Voucher và giữ lại lịch sử hóa đơn liên quan!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đồng ý xóa!',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: url,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire(
                                    'Đã xóa!',
                                    data.message,
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire(
                                    'Lỗi!',
                                    data.message,
                                    'error'
                                );
                            }
                        }
                    });
                }
            })
        }
    </script>
}
