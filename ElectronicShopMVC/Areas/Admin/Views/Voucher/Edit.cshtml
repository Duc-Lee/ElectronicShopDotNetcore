@model ElectronicShopMVC.Model.Voucher
@{
    ViewData["Title"] = "Chỉnh sửa Voucher - Admin";
}

<div class="container mt-4">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Order" asp-action="Index">Quản lý Admin</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Quản lý Voucher</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom border-secondary border-opacity-10 pb-3">
        <h2 class="h3 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-pencil-square text-primary"></i>
            <span class="gradient-text">Chỉnh Sửa Voucher</span>
        </h2>
        <a asp-action="Index" class="btn btn-secondary btn-sm py-2 px-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="glass-panel p-4 mb-5" style="border-top: 4px solid var(--accent-orange, #ff9800) !important;">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <!-- Code & Title -->
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label fw-bold small text-muted">MÃ CODE VOUCHER (VIẾT HOA, KHÔNG DẤU)</label>
                            <input asp-for="Code" class="form-control text-uppercase font-monospace" placeholder="Ví dụ: WINTER20" required />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-bold small text-muted">TIÊU ĐỀ KHUYẾN MÃI</label>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Giảm giá 20% đón mùa đông lạnh giá..." required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold small text-muted">MÔ TẢ CHI TIẾT VOUCHER</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Nội dung điều kiện áp dụng, chi tiết ưu đãi..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Discount Type, Value, Min Spend, Max Discount -->
                        <div class="col-md-3">
                            <label asp-for="DiscountType" class="form-label fw-bold small text-muted">LOẠI GIẢM GIÁ</label>
                            <select asp-for="DiscountType" class="form-select" id="discountTypeSelect">
                                <option value="Percentage">Theo phần trăm (%)</option>
                                <option value="FixedAmount">Số tiền cố định (đ)</option>
                                <option value="FreeShipping">Miễn phí ship (Free Ship)</option>
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3" id="discountValueGroup">
                            <label asp-for="DiscountValue" class="form-label fw-bold small text-muted">MỨC GIẢM GIÁ</label>
                            <input asp-for="DiscountValue" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="MinOrderAmount" class="form-label fw-bold small text-muted">ĐƠN HÀNG TỐI THIỂU (đ)</label>
                            <input asp-for="MinOrderAmount" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="MinOrderAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3" id="maxDiscountGroup">
                            <label asp-for="MaxDiscountAmount" class="form-label fw-bold small text-muted">GIẢM TỐI ĐA (đ, Null = Không giới hạn)</label>
                            <input asp-for="MaxDiscountAmount" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="MaxDiscountAmount" class="text-danger small"></span>
                        </div>

                        <!-- Start Date, End Date, Max Uses, Active -->
                        <div class="col-md-3">
                            <label asp-for="StartDate" class="form-label fw-bold small text-muted">NGÀY BẮT ĐẦU</label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EndDate" class="form-label fw-bold small text-muted">NGÀY HẾT HẠN</label>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="MaxUses" class="form-label fw-bold small text-muted">LƯỢT SỬ DỤNG TỐI ĐA (0 = Vô hạn)</label>
                            <input asp-for="MaxUses" type="number" class="form-control" required />
                            <span asp-validation-for="MaxUses" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 d-flex align-items-center">
                            <div class="form-check form-switch mt-4">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="IsActive" class="form-check-label fw-bold small text-muted">KÍCH HOẠT VOUCHER</label>
                            </div>
                        </div>

                        <!-- Info Metadata -->
                        <div class="col-12 mt-3 small text-muted border-top border-secondary border-opacity-10 pt-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <i class="bi bi-clock me-1"></i><strong>Đã sử dụng:</strong> @Model.UsedCount @(Model.MaxUses > 0 ? $"/ {Model.MaxUses}" : "") lượt
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <i class="bi bi-person me-1"></i><strong>Người tạo:</strong> @(string.IsNullOrEmpty(Model.CreatedBy) ? "Hệ thống" : Model.CreatedBy)
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="col-12 text-end border-top border-secondary border-opacity-10 pt-3 mt-4">
                            <a asp-action="Index" class="btn btn-secondary px-4 py-2 me-2">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4 py-2">
                                <i class="bi bi-check-circle me-2"></i>Lưu Thay Đổi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function toggleFields() {
                var val = $('#discountTypeSelect').val();
                if (val === 'FreeShipping') {
                    $('#discountValueGroup').hide();
                    $('#discountValueGroup input').val(0).prop('required', false);
                    $('#maxDiscountGroup').hide();
                } else if (val === 'FixedAmount') {
                    $('#discountValueGroup').show();
                    $('#discountValueGroup input').prop('required', true);
                    $('#maxDiscountGroup').hide();
                } else {
                    $('#discountValueGroup').show();
                    $('#discountValueGroup input').prop('required', true);
                    $('#maxDiscountGroup').show();
                }
            }

            $('#discountTypeSelect').change(toggleFields);
            toggleFields();
        });
    </script>
}
