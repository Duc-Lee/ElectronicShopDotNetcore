@model Cart
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="py-3">
    <!-- Header -->
    <div class="d-flex align-items-center gap-2 mb-4 border-bottom border-secondary border-opacity-10 pb-3">
        <h1 class="h3 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-cart3 text-info"></i>
            <span class="gradient-text">Giỏ hàng của bạn</span>
        </h1>
        <span class="badge text-bg-primary" style="font-size: 0.85rem !important;" id="cart-items-count-badge">
            @Model.Items!.Sum(x => x.quantity) sản phẩm
        </span>
    </div>

    <div class="row g-4">
        <!-- Cart Items List (Left Column) -->
        <div class="col-lg-8" id="cart-items-container">
            @if (!Model.Items!.Any())
            {
                <div class="glass-panel p-5 text-center">
                    <i class="bi bi-cart-x text-muted opacity-50" style="font-size: 5rem;"></i>
                    <h3 class="mt-3 text-main">Giỏ hàng của bạn đang trống!</h3>
                    <p class="text-muted">Hãy quay lại trang chủ và khám phá hàng ngàn sản phẩm công nghệ hấp dẫn.</p>
                    <a class="btn btn-primary mt-4" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house me-2"></i> Quay về trang chủ
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items!)
                    {
                        <div class="glass-panel p-3 d-flex align-items-center" id="cart-item-@item.Product.Id" style="transition: var(--transition-smooth); border-color: var(--border-color);">
                            <!-- Image -->
                            <div class="bg-black bg-opacity-5 rounded-3 p-2 d-flex align-items-center justify-content-center me-3" style="width: 90px; height: 90px; flex-shrink: 0; border: 1px solid var(--border-color);">
                                <img src="@item.Product.ImageUrl" alt="@item.Product.Title" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                            </div>

                            <!-- Info & Actions -->
                            <div class="flex-grow-1 min-w-0">
                                <a class="text-decoration-none text-main fw-bold d-block text-truncate fs-5"
                                   asp-controller="Home" asp-action="Details"
                                   asp-route-id="@item.Product.Id">
                                    @item.Product.Title
                                </a>
                                <span class="text-info small fw-semibold">@item.Product.Brand</span>

                                <div class="d-flex align-items-center mt-2 gap-3 flex-wrap">
                                    <div class="input-group input-group-sm" style="width: 130px;">
                                        <input class="form-control text-center text-main bg-white border fw-bold cart-item-quantity-input"
                                               id="quantity-@item.Product.Id-input"
                                               data-id="@item.Product.Id"
                                               type="number" value="@item.quantity"
                                               min="1" max="1000" />
                                        <span class="input-group-text bg-light border text-muted font-monospace">S.L</span>
                                    </div>
                                    <button class="btn btn-link text-danger cart-item-remove-btn p-0 text-decoration-none d-inline-flex align-items-center gap-1"
                                            data-id="@item.Product.Id">
                                        <i class="bi bi-trash3-fill"></i>
                                        <span>Xóa</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Price Column -->
                            <div class="text-end ms-3" style="min-width: 120px;">
                                <h5 class="text-main fw-bold mb-1" id="total-price-@item.Product.Id">@item.TotalPrice.ToString("c")</h5>
                                <div class="text-muted small">
                                    @item.Product.Price.ToString("c") &times; <span id="quantity-@item.Product.Id">@item.quantity</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Cart Summary Sticky Card (Right Column) -->
        @if (Model.Items.Any())
        {
            <div class="col-lg-4" id="cart-summary-container">
                <div class="cart-summary-card">
                    <h3 class="h4 text-main fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-text text-info"></i> Tóm tắt đơn hàng
                    </h3>
                    <hr class="border-secondary border-opacity-10 my-3" />

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="text-main fw-semibold" id="subtotal">@Model.Subtotal.ToString("c")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">VAT (@(ElectronicShopMVC.Utility.Constants.Prices.Vat * 100)%):</span>
                        <span class="text-main fw-semibold" id="vat">@Model.Vat.ToString("c")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="text-main fw-semibold" id="shipping">@Model.Shipping.ToString("c")</span>
                    </div>

                    <!-- Coupon Discount Row -->
                    <div class="d-flex justify-content-between mb-3 d-none" id="discount-row" style="animation: fadeIn 0.4s ease-out;">
                        <span class="text-danger fw-semibold" id="discount-label">Giảm giá:</span>
                        <span class="text-danger fw-bold" id="discount-amount">-0 ₫</span>
                    </div>

                    <hr class="border-secondary border-opacity-10 my-3" />

                    <!-- Coupon Code Input Panel -->
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold mb-1">Mã giảm giá (Voucher):</label>
                        <div class="input-group">
                            <input type="text" class="form-control text-uppercase fw-bold border" id="coupon-code" placeholder="Nhập ESHOP10, FREESHIP..." />
                            <button class="btn btn-outline-primary" type="button" id="apply-coupon-btn">Áp dụng</button>
                        </div>
                        <div id="coupon-message" class="small mt-1 d-none"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-main fw-bold">Tổng thanh toán:</span>
                        <h4 class="text-info fw-extrabold mb-0" id="total">@Model.Total.ToString("c")</h4>
                    </div>

                    <a class="btn btn-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2 fw-bold" id="checkout-btn" asp-action="Summary">
                        <span>ĐẾN TRANG THANH TOÁN</span>
                        <i class="bi bi-credit-card-2-back-fill fs-5"></i>
                    </a>

                    <a class="btn btn-secondary w-100 mt-2 py-2 d-flex align-items-center justify-content-center gap-2" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-arrow-left"></i> Tiếp tục mua hàng
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/cart.js"></script>
}
